<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Car">
        <ListPreference
            app:key="car"
            app:title="Car"
            app:defaultValue="gr86"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:key="wheels"
            app:title="Wheels (wireframe)"
            app:defaultValue="5spoke"
            app:entries="@array/wheel_names"
            app:entryValues="@array/wheel_values"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:key="body_kit"
            app:title="Lowered with lip, side skirts and ducktail"
            app:defaultValue="true" />
        <ListPreference
            app:key="transmission"
            app:title="Gearbox"
            app:defaultValue="mt"
            app:entries="@array/transmission_names"
            app:entryValues="@array/transmission_values"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Connection">
        <ListPreference
            app:key="source"
            app:title="Data source"
            app:defaultValue="demo"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:key="bt_device"
            app:title="Bluetooth adapter" />
        <Preference
            app:key="ble_scan"
            app:title="Scan for Bluetooth LE adapters"
            app:summary="DauntlessOBD: pair it in the Dauntless OBD app first, then pick it from the list above" />
        <EditTextPreference
            app:key="tcp_host"
            app:title="Adapter IP address"
            app:summary="Blank = default (ELM327 Wi-Fi 192.168.0.10, WiCAN 192.168.80.1)" />
        <EditTextPreference
            app:key="tcp_port"
            app:title="Adapter TCP port"
            app:summary="Blank = default (ELM327 35000, WiCAN slcan 3333)" />
        <EditTextPreference
            app:key="usb_baud"
            app:title="USB baud rate"
            app:defaultValue="115200"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:key="elm_mode"
            app:title="Read mode"
            app:defaultValue="auto"
            app:entries="@array/elm_mode_names"
            app:entryValues="@array/elm_mode_values"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="CAN bus">
        <Preference
            app:key="edit_profile"
            app:title="Edit CAN profile"
            app:summary="Which CAN ids / bytes feed RPM, speed, temps… (raw CAN modes)" />
        <Preference
            app:key="learn_signals"
            app:title="Learn body signals"
            app:summary="Find doors, locks, belt, lights, indicators, wipers, VDC and cruise on your car's bus, step by step" />
        <Preference
            app:key="open_sniffer"
            app:title="CAN sniffer"
            app:summary="See every id on the bus live to find or verify signals" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Music and navigation">
        <Preference
            app:key="notification_access"
            app:title="Show Spotify and Google Maps on the dash"
            app:summary="Needs notification access" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Drive logs">
        <Preference
            app:key="share_log"
            app:title="Share latest drive log"
            app:summary="Record from the Timers page; logs are CSV with every signal at 20 Hz" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Display">
        <ListPreference
            app:key="units"
            app:title="Units"
            app:defaultValue="imperial"
            app:entries="@array/unit_names"
            app:entryValues="@array/unit_values"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:key="theme"
            app:title="Theme"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="shift_rpm"
            app:title="Shift light RPM"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="redline"
            app:title="Redline RPM"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="max_rpm"
            app:title="Tach maximum RPM"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:key="fill_car_screen"
            app:title="Fill the car screen"
            app:summary="Draw under Android Auto's buttons, which hide when you're not touching the screen. Turn off to keep the dash clear of them."
            app:defaultValue="true" />
        <SwitchPreferenceCompat
            app:key="phone_g"
            app:title="Use phone sensors for G-meter"
            app:summary="Mount the phone upright facing you or flat with its top toward the windscreen"
            app:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Gearing (gear estimate and rev-match score)">
        <EditTextPreference
            app:key="gear_ratios"
            app:title="Gear ratios"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="final_drive"
            app:title="Final drive"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="tire_size"
            app:title="Rear tyre size"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
</PreferenceScreen>
