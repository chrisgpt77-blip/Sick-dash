<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06070A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:id="@+id/step" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#768191"
            android:textSize="13sp" android:letterSpacing="0.12" />

        <TextView android:id="@+id/prompt" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#ECF0F5"
            android:textSize="26sp" android:textStyle="bold" android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <ProgressBar android:id="@+id/progress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:max="100" />

        <TextView android:id="@+id/status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#768191"
            android:textSize="14sp" android:paddingTop="8dp" />

        <TextView android:id="@+id/result" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#ECF0F5"
            android:textSize="15sp" android:paddingTop="16dp" />

        <TextView android:id="@+id/live" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#FF2448"
            android:textSize="22sp" android:textStyle="bold" android:paddingTop="8dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="16dp">
            <Button android:id="@+id/btn_main" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" />
            <Button android:id="@+id/btn_alt" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" />
            <Button android:id="@+id/btn_skip" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
