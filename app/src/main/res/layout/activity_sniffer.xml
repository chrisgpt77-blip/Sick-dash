<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06070A"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/btn_pause" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Pause" />
        <Button android:id="@+id/btn_clear" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Clear" />
    </LinearLayout>

    <TextView android:id="@+id/header" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#768191"
        android:textSize="12sp" android:paddingTop="8dp" />

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <TextView android:id="@+id/table" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#ECF0F5"
            android:textSize="13sp" android:textIsSelectable="true" />
    </ScrollView>
</LinearLayout>
